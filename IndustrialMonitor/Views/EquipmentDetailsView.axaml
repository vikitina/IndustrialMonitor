
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:IndustrialMonitor.Models"
             xmlns:converters="using:IndustrialMonitor.Converters"
             xmlns:views="using:IndustrialMonitor.Views"
             x:Class="IndustrialMonitor.Views.EquipmentDetailsView"
             x:DataType="models:Equipment">

  <UserControl.Resources>
    <converters:EquipmentStatusBrushConverter
      x:Key="StatusBrushConverter"/>
  </UserControl.Resources>

  <Border Classes="card">

    <StackPanel Spacing="20">

      <!-- HEADER -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Classes="section-title"
                     Text="Equipment Details"/>

          <TextBlock Text="{Binding Name}"
                     Classes="muted"/>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding StatusText}"
                   Foreground="{Binding Status,
                   Converter={StaticResource StatusBrushConverter}}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>
      </Grid>

      <!-- SENSOR VALUES -->
      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="16">

        <!-- TEMPERATURE -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="10"
                Padding="18">

          <StackPanel Spacing="12">

            <TextBlock Text="Temperature"
                       Classes="muted"/>

            <TextBlock Text="{Binding TemperatureText}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="8"
                         Value="{Binding TemperaturePercent}"/>

            <TextBlock Text="Range: 0–120 °C"
                       Classes="muted"
                       FontSize="12"/>

          </StackPanel>
        </Border>

        <!-- PRESSURE -->
        <Border Grid.Column="1"
                Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="10"
                Padding="18">

          <StackPanel Spacing="12">

            <TextBlock Text="Pressure"
                       Classes="muted"/>

            <TextBlock Text="{Binding PressureText}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="8"
                         Value="{Binding PressurePercent}"/>

            <TextBlock Text="Range: 0–16 bar"
                       Classes="muted"
                       FontSize="12"/>

          </StackPanel>
        </Border>
      </Grid>

      <!-- LIVE TEMPERATURE CHART -->
      <views:TemperatureChartView/>
      
    </StackPanel>
  </Border>
</UserControl>
